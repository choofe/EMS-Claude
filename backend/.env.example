# Copy this file to .env for local development. Never commit the real .env.

ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://ems_user:ems_password@localhost:5432/ems_db

# Enables the Postgres-backed tests (tests/postgres/). The database name MUST
# end with _test; it is created automatically and wiped/migrated by the tests.
TEST_DATABASE_URL=postgresql+asyncpg://ems_user:ems_password@localhost:5432/ems_test

# At least 32 random chars. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Refresh-token cookie. In production Secure must be true; if frontend and API
# are on different sites, SameSite=none is required (and Secure) — see docs/auth.md.
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
# REFRESH_COOKIE_DOMAIN=
# Only behind exactly ONE trusted reverse proxy (uses the last X-Forwarded-For entry).
TRUST_FORWARDED_FOR=false

DEFAULT_REPORT_EDIT_WINDOW_HOURS=24
TIMEZONE=Asia/Tehran

CORS_ALLOW_ORIGINS=["http://localhost:5173"]

LOG_LEVEL=INFO
