# Copy this file to .env for local development. Never commit the real .env.
# Open the app as http://localhost:5173 (NOT 127.0.0.1): the API's CORS/CSRF allow-list names that exact origin.
# Production: frontend and API must be SAME-SITE (see docs/auth.md), e.g. app.example.com -> api.example.com.
VITE_API_BASE_URL=http://localhost:8000
